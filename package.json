{
  "name": "@local/zzz-spine",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "绝区零立绘挂件：输入框右上角的 Spine 角色（可点击穿透），以及「深度求索中」文案的改写和前面旋转的小黄花。",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/smoke-client.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "locale/*.json",
    "docs",
    "icon.svg",
    "vendor",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
